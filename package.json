{
  "name": "puml-canvas-js",
  "version": "0.5.0",
  "description": "Native JavaScript implementation of PlantUML diagram rendering for the browser",
  "type": "module",
  "license": "MIT",
  "author": "battlecook",
  "homepage": "https://github.com/battlecook/puml-canvas-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/battlecook/puml-canvas-js.git"
  },
  "bugs": {
    "url": "https://github.com/battlecook/puml-canvas-js/issues"
  },
  "keywords": [
    "plantuml",
    "uml",
    "diagram",
    "svg",
    "renderer",
    "typescript",
    "sequence-diagram",
    "class-diagram",
    "activity-diagram",
    "state-diagram",
    "gantt",
    "mindmap"
  ],
  "main": "./dist/puml-canvas-js.js",
  "module": "./dist/puml-canvas-js.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/puml-canvas-js.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0",
    "vitest": "^1.4.0"
  }
}
